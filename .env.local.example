# Copy this file to .env.local and fill in the client's Supabase project values.
# Found in Supabase Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public site's own base URL (no trailing slash) — used to build the
# absolute /rate/[token] review link sent to customers over WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
